    Complex insertVal(3.14, 2.71);
    if (vec.size() > 5) {
        vec.insert(vec.begin() + 5, insertVal);
    } else {
        vec.push_back(insertVal);  // 若向量长度不足5，直接尾插
    }
    cout << "\n4. 插入元素 " << insertVal << " 后：" << endl;
    for (int i = 0; i < vec.size(); ++i) {
        cout << "  索引" << i << "：" << vec[i] << endl;
    }

    // 删除：删除所有与insertVal相同的元素
    int deleteCount = deleteElement(vec, insertVal);
    cout << "\n5. 删除元素 " << insertVal << "：" << endl;
    cout << "  共删除 " << deleteCount << " 个元素" << endl;
    cout << "  删除后向量：" << endl;
    for (int i = 0; i < vec.size(); ++i) {
        cout << "  索引" << i << "：" << vec[i] << endl;
    }

    // 唯一化
    uniqueVector(vec);
    cout << "\n6. 唯一化后向量（长度：" << vec.size() << "）：" << endl;
    for (int i = 0; i < vec.size(); ++i) {
        cout << "  索引" << i << "：" << vec[i] << endl;
    }

    // -------------------------- （2）测试排序效率 --------------------------
    // 建议向量长度设为1000~5000（起泡排序在长度10000以上会较慢，便于对比差异）
    testSortEfficiency(2000);

    // -------------------------- （3）测试区间查找 --------------------------
    cout << "\n=== 测试区间查找 ===" << endl;
    // 生成长度为20的向量并排序（区间查找需基于已排序向量）
    vector<Complex> sortedVec = generateRandomVector(20);
    mergeSort(sortedVec, 0, sortedVec.size() - 1);
    cout << "1. 已排序向量（按模升序）：" << endl;
    for (const auto& c : sortedVec) {
        cout << "  " << c << "（模：" << fixed << setprecision(2) << c.getModulus() << "）" << endl;
    }

    // 查找模介于 [50, 100) 的元素（可自行调整m1和m2）
    double m1 = 50.0, m2 = 100.0;
    vector<Complex> rangeResult = rangeSearch(sortedVec, m1, m2);
    cout << "\n2. 模介于 [" << m1 << ", " << m2 << ") 的元素（共 " << rangeResult.size() << " 个）：" << endl;
    for (const auto& c : rangeResult) {
        cout << "  " << c << "（模：" << fixed << setprecision(2) << c.getModulus() << "）" << endl;
    }

    return 0;
}
