    for (int i = 0; i < vec.size(); ++i) {
        cout << "  索引" << i << "：" << vec[i] << endl;
    }

    // 查找：随机选一个元素作为目标（这里选索引2的元素）
    if (vec.size() > 2) {
        Complex target = vec[2];
        int findIdx = findElement(vec, target);
        cout << "\n3. 查找元素 " << target << "：" << endl;
        if (findIdx != -1) {
            cout << "  找到，索引为：" << findIdx << endl;
