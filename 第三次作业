class UndirectedGraph {
public:
    vector<string> nodes;                  
    unordered_map<string, int> nodeIndex;
    vector<vector<int>> adjMatrix;        
    int nodeCount;                        

   
    UndirectedGraph(const vector<string>& nodeList) {
        nodes = nodeList;
        nodeCount = nodes.size();
        for (int i = 0; i < nodeCount; ++i) {
            nodeIndex[nodes[i]] = i;
        }
        
        adjMatrix.resize(nodeCount, vector<int>(nodeCount, 0));
    }

    
    void addEdge(const string& u, const string& v, int weight = 1) {
        int i = nodeIndex[u];
        int j = nodeIndex[v];
        adjMatrix[i][j] = weight;
        adjMatrix[j][i] = weight;
    }

    
    void printAdjMatrix() const {
        cout << "\t";
        for (const string& node : nodes) {
            cout << node << "\t";
        }
        cout << endl;
        for (int i = 0; i < nodeCount; ++i) {
            cout << nodes[i] << "\t";
            for (int j = 0; j < nodeCount; ++j) {
                cout << adjMatrix[i][j] << "\t";
            }
            cout << endl;
        }
    }
};



vector<string> BFS(const UndirectedGraph& graph, const string& startNode) {
    vector<string> bfsOrder;
    unordered_set<string> visited;
    queue<string> q;

    q.push(startNode);
    visited.insert(startNode);

    while (!q.empty()) {
        string current = q.front();
        q.pop();
        bfsOrder.push_back(current);

        for (const string& neighbor : graph.nodes) {
            int currIdx = graph.nodeIndex[current];
            int neighborIdx = graph.nodeIndex[neighbor];
            if (graph.adjMatrix[currIdx][neighborIdx] > 0 && !visited.count(neighbor)) {
                visited.insert(neighbor);
                q.push(neighbor);
            }
        }
    }
    return bfsOrder;
}


void DFSHelper(const UndirectedGraph& graph, const string& current,
               unordered_set<string>& visited, vector<string>& dfsOrder) {
    visited.insert(current);
    dfsOrder.push_back(current);

    for (const string& neighbor : graph.nodes) {
        int currIdx = graph.nodeIndex[current];
        int neighborIdx = graph.nodeIndex[neighbor];
        if (graph.adjMatrix[currIdx][neighborIdx] > 0 && !visited.count(neighbor)) {
            DFSHelper(graph, neighbor, visited, dfsOrder);
        }
    }
}


vector<string> DFS(const UndirectedGraph& graph, const string& startNode) {
    vector<string> dfsOrder;
    unordered_set<string> visited;
    DFSHelper(graph, startNode, visited, dfsOrder);
    return dfsOrder;
}

void printTraversal(const string& algo, const vector<string>& order) {
    cout << algo << " 遍历顺序：";
    for (int i = 0; i < order.size(); ++i) {
        if (i > 0) cout << " -> ";
        cout << order[i];
    }
    cout << endl;
}


struct DijkstraRes {
    unordered_map<string, int> dist;   
    unordered_map<string, string> prev;
};


DijkstraRes Dijkstra(const UndirectedGraph& graph, const string& startNode) {
    DijkstraRes res;
    unordered_set<string> visited;
    
    priority_queue<pair<int, string>, vector<pair<int, string>>, greater<>> pq;

    
    for (const string& node : graph.nodes) {
        res.dist[node] = INT_MAX;
        res.prev[node] = "";
    }
    res.dist[startNode] = 0;
    pq.push({0, startNode});

    while (!pq.empty()) {
        auto [currDist, curr] = pq.top();
        pq.pop();

        if (visited.count(curr)) continue;
        visited.insert(curr);

       
        for (const string& neighbor : graph.nodes) {
            int currIdx = graph.nodeIndex[curr];
            int neighborIdx = graph.nodeIndex[neighbor];
            int weight = graph.adjMatrix[currIdx][neighborIdx];

            if (weight > 0 && !visited.count(neighbor) && currDist + weight < res.dist[neighbor]) {
                res.dist[neighbor] = currDist + weight;
                res.prev[neighbor] = curr;
                pq.push({res.dist[neighbor], neighbor});
            }
        }
    }
    return res;
}


vector<string> getShortestPath(const DijkstraRes& res, const string& start, const string& target) {
    vector<string> path;
    string curr = target;

    while (!curr.empty()) {
        path.push_back(curr);
        curr = res.prev[curr];
        if (path.size() > res.prev.size()) break; 
    }

    if (path.back() != start) return {"无路径"};
    reverse(path.begin(), path.end());
    return path;
}


void printShortestPaths(const DijkstraRes& res, const string& start) {
    cout << "\n从 " << start << " 出发的最短路径：" << endl;
    for (const string& target : res.dist.keys()) {
        if (res.dist[target] == INT_MAX) {
            cout << start << " -> " << target << "：无连通路径" << endl;
            continue;
        }
        vector<string> path = getShortestPath(res, start, target);
        cout << start << " -> " << target << "：";
        for (int i = 0; i < path.size(); ++i) {
            if (i > 0) cout << " -> ";
            cout << path[i];
        }
        cout << "（距离：" << res.dist[target] << "）" << endl;
    }
}


struct Edge {
    string u, v;
    int weight;
    Edge(string u_, string v_, int w_) : u(u_), v(v_), weight(w_) {}
};


vector<Edge> Prim(const UndirectedGraph& graph, const string& startNode) {
    vector<Edge> mst;
    unordered_set<string> selected;
    selected.insert(startNode);

    while (selected.size() < graph.nodeCount) {
        Edge minEdge("", "", INT_MAX);
        
        for (const string& u : selected) {
            int uIdx = graph.nodeIndex[u];
            for (const string& v : graph.nodes) {
                if (selected.count(v) || graph.adjMatrix[uIdx][graph.nodeIndex[v]] == 0) continue;
                int w = graph.adjMatrix[uIdx][graph.nodeIndex[v]];
                if (w < minEdge.weight) {
                    minEdge = Edge(u, v, w);
                }
            }
        }
        if (minEdge.weight == INT_MAX) break; 
        mst.push_back(minEdge);
        selected.insert(minEdge.v);
    }
    return mst;
}


void printMST(const vector<Edge>& mst) {
    cout << "\n最小支撑树（MST）边集合：" << endl;
    int totalWeight = 0;
    for (const Edge& e : mst) {
        cout << e.u << " - " << e.v << "（权重：" << e.weight << "）" << endl;
        totalWeight += e.weight;
    }
    cout << "MST 总权值：" << totalWeight << endl;
}



struct TarjanRes {
    unordered_set<string> articulationPoints; 
    vector<vector<pair<string, string>>> bcc; /
};

TarjanRes Tarjan(const UndirectedGraph& graph, const string& startNode) {
    TarjanRes res;
    unordered_map<string, int> disc, low; 
    int time = 0;
    stack<pair<string, string>> edgeStack; 
    unordered_set<string> visited;

    function<void(const string&, const string&)> dfs = [&](const string& u, const string& parent) {
        disc[u] = low[u] = ++time;
        visited.insert(u);
        int children = 0;

        for (const string& v : graph.nodes) {
            int uIdx = graph.nodeIndex[u];
            int vIdx = graph.nodeIndex[v];
            if (graph.adjMatrix[uIdx][vIdx] == 0) continue; // 无边

            if (!visited.count(v)) {
                children++;
                edgeStack.push({u, v});
                dfs(v, u);
                low[u] = min(low[u], low[v]);

                
                bool isArticulation = (parent.empty() && children >= 2) || 
                                     (!parent.empty() && low[v] >= disc[u]);
                if (isArticulation) {
                    res.articulationPoints.insert(u);
                    
                    vector<pair<string, string>> component;
                    while (true) {
                        auto edge = edgeStack.top();
                        edgeStack.pop();
                        component.push_back(edge);
                        if ((edge.first == u && edge.second == v) || (edge.first == v && edge.second == u)) {
                            break;
                        }
                    }
                    res.bcc.push_back(component);
                }
            } else if (v != parent && disc[v] < disc[u]) { // 回边（非父节点）
                edgeStack.push({u, v});
                low[u] = min(low[u], disc[v]);
            }
        }
    };

    
    dfs(startNode, "");
    
    if (!edgeStack.empty()) {
        vector<pair<string, string>> component;
        while (!edgeStack.empty()) {
            component.push_back(edgeStack.top());
            edgeStack.pop();
        }
        res.bcc.push_back(component);
    }

    return res;
}

