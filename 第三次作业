vector<set<pair<string, string>>> normalizeBCC(const vector<vector<pair<string, string>>>& bcc) {
    vector<set<pair<string, string>>> normalized;
    for (const auto& comp : bcc) {
        set<pair<string, string>> s;
        for (const auto& [u, v] : comp) {
            s.insert(u < v ? make_pair(u, v) : make_pair(v, u));
        }
        normalized.push_back(s);
    }
    sort(normalized.begin(), normalized.end()); 
    return normalized;
}


void printTarjanRes(const TarjanRes& res, const string& start) {
    cout << "\n起点 " << start << " 结果：" << endl;
    
    cout << "关节点：";
    if (res.articulationPoints.empty()) {
        cout << "无";
    } else {
        int i = 0;
        for (const string& ap : res.articulationPoints) {
            if (i > 0) cout << ", ";
            cout << ap;
            i++;
        }
    }
    cout << endl;
    
    cout << "双连通分量（共 " << res.bcc.size() << " 个）：" << endl;
    for (int i = 0; i < res.bcc.size(); ++i) {
        cout << "  分量" << i + 1 << "：";
        for (int j = 0; j < res.bcc[i].size(); ++j) {
            auto [u, v] = res.bcc[i][j];
            if (j > 0) cout << ", ";
            cout << "(" << u << "," << v << ")";
        }
        cout << endl;
    }
}


