    vector<string> graph2Nodes = {"1", "2", "3", "4", "5", "6", "7", "8"};
    UndirectedGraph graph2(graph2Nodes);
    
    vector<pair<string, string>> graph2Edges = {
        {"1", "2"}, {"2", "3"}, {"3", "1"}, {"2", "4"}, {"4", "5"}, {"5", "6"},
        {"6", "4"}, {"5", "7"}, {"7", "8"}, {"8", "5"}
    };
    for (auto [u, v] : graph2Edges) {
        graph2.addEdge(u, v);
    }

   
    cout << "\n\n==================== 图2 测试结果 ====================" << endl;
    cout << "4. 不同起点的双连通分量与关节点（Tarjan）：" << endl;
    vector<string> testStarts = {"1", "4", "7"}; // 选取3个不同起点
    vector<TarjanRes> tarjanResults;

    
    for (const string& start : testStarts) {
        TarjanRes res = Tarjan(graph2, start);
        tarjanResults.push_back(res);
        printTarjanRes(res, start);
    }

    
    bool allSame = true;
    if (tarjanResults.size() >= 2) {
        
        auto firstAP = tarjanResults[0].articulationPoints;
        auto firstBCC = normalizeBCC(tarjanResults[0].bcc);

        for (int i = 1; i < tarjanResults.size(); ++i) {
            auto currAP = tarjanResults[i].articulationPoints;
            auto currBCC = normalizeBCC(tarjanResults[i].bcc);

            if (currAP != firstAP || currBCC != firstBCC) {
                allSame = false;
                break;
            }
        }
    }

    cout << "\n结论：图2不同起点下双连通分量与关节点结果" << (allSame ? "一致" : "不一致") << endl;

    return 0;
}
