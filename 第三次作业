    for (auto [u, v, w] : graph1Edges) {
        graph1.addEdge(u, v, w);
    }

    
    cout << "==================== 图1 测试结果 ====================" << endl;
   
    cout << "\n1. 图1邻接矩阵：" << endl;
    graph1.printAdjMatrix();

    
    cout << "\n2. 从A出发的遍历结果：" << endl;
    vector<string> bfsOrder = BFS(graph1, "A");
    printTraversal("BFS", bfsOrder);
    vector<string> dfsOrder = DFS(graph1, "A");
    printTraversal("DFS", dfsOrder);

    
    cout << "\n3. 从A出发的最短路径（Dijkstra）：" << endl;
    DijkstraRes dijkstraRes = Dijkstra(graph1, "A");
    printShortestPaths(dijkstraRes, "A");

    cout << "\n4. 图1最小支撑树（Prim）：" << endl;
    vector<Edge> mst = Prim(graph1, "A");
