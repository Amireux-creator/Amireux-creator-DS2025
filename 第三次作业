    vector<string> graph1Nodes = {"A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"};
    UndirectedGraph graph1(graph1Nodes);
    // 自定义图1边（带权重，模拟合理结构）
    vector<tuple<string, string, int>> graph1Edges = {
        {"A", "B", 2}, {"A", "C", 3}, {"B", "D", 1}, {"B", "E", 4}, {"C", "F", 2}, {"C", "G", 1},
        {"D", "H", 5}, {"E", "I", 2}, {"F", "J", 3}, {"G", "K", 4}, {"H", "L", 1}, {"I", "L", 3},
